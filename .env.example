# Copy to .env and edit, or just run ./install.sh and answer the prompts.

# Must be the SAME paths your Radarr/Sonarr/Transmission containers use --
# relocarr needs to see files at the exact path the *arr reports them at.
DOWNLOADS_PATH=/home/user/Downloads
MEDIA_PATH=/mnt/nvidia

# Existing Docker network your *arr stack is on, so relocarr can reach it by
# container name (e.g. http://radarr:7878). Leave blank to skip and reach
# your *arr apps by host IP instead.
ARR_NETWORK_NAME=arr-stack_lan-net

PUID=1000
PGID=1000
RELOCARR_PORT=8686
